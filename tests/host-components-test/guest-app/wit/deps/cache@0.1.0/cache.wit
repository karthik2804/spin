package example:cache@0.1.0;

/// A simple regional cache interface for local development.
/// In production, the deployment platform would provide this interface
/// backed by a production-grade caching system.
interface store {
    /// Errors that can occur during cache operations.
    variant error {
        /// The store does not exist or could not be accessed.
        store-not-found(string),
        /// A generic error occurred.
        other(string),
    }

    /// Get a value from the cache.
    /// Returns none if the key is not found or has expired.
    get: func(store-name: string, key: string) -> result<option<list<u8>>, error>;

    /// Set a value in the cache with an optional TTL in milliseconds.
    /// If ttl-ms is none, the value does not expire.
    set: func(store-name: string, key: string, value: list<u8>, ttl-ms: option<u64>) -> result<_, error>;

    /// Delete a key from the cache.
    delete: func(store-name: string, key: string) -> result<_, error>;

    /// Check if a key exists in the cache.
    exists: func(store-name: string, key: string) -> result<bool, error>;
}

world cache-provider {
    export store;
}
